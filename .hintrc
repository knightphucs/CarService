{
  "extends": [
    "development"
  ],
  "hints": {
    "axe/text-alternatives": [
      "default",
      {
        "image-alt": "off"
      }
    ],
    "axe/name-role-value": [
      "default",
      {
        "button-name": "off"
      }
    ],
    "axe/forms": "off",
    "axe/aria": [
      "default",
      {
        "aria-required-children": "off",
        "aria-command-name": "off",
        "aria-valid-attr-value": "off"
      }
    ],
    "compat-api/html": [
      "default",
      {
        "ignore": [
          "input[autocapitalize]"
        ]
      }
    ],
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "user-select",
          "backdrop-filter"
        ]
      }
    ]
  }
}